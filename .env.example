# ============================================================
# PUBLIC — safe to expose to browser
# ============================================================

# Google Apps Script Web App deployment URL (boot + bookings API)
PUBLIC_GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Razorpay publishable key (NOT the secret key)
PUBLIC_RAZORPAY_KEY=rzp_live_XXXXXXXXXXXXXXXX

# Site base URL (used for OG tags, canonical links)
PUBLIC_SITE_URL=https://yourdomain.com

# ============================================================
# PRIVATE — server-only, never exposed to browser
# ============================================================

# Used by Astro SSR API routes only (not in client bundles)
GAS_ADMIN_SECRET=your-shared-secret-between-astro-and-gas

# Email service (for OTP) — Resend.com recommended
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
FROM_EMAIL=noreply@yourdomain.com

# Razorpay secret (for webhook signature verification)
RAZORPAY_SECRET=your_razorpay_secret

# ============================================================
# DEV / STAGING
# ============================================================
NODE_ENV=development
# Set to "true" to enable mock data fallbacks (NEVER in production)
ENABLE_MOCK_DATA=false

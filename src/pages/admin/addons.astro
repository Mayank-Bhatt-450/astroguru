---
// src/pages/admin/addons.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminAddonsManager from '../../components/admin/AdminAddonsManager';
---
<AdminLayout title="Add-ons — AstroGuru Admin" activeTab="addons">
  <div style="margin-bottom:24px;">
    <h1 style="font-family:var(--font-display); font-size:clamp(1.4rem,3vw,1.8rem); font-weight:700; color:var(--color-midnight-ink); margin-bottom:6px;">
      Add-ons
    </h1>
    <p style="font-size:14px; color:var(--color-slate);">
      Create optional extras customers can add to any booking. Mark add-ons as "popular default" to pre-select them for Most Popular service tiers.
    </p>
  </div>

  <div style="background:white; border-radius:20px; padding:clamp(20px,4vw,32px); border:1px solid var(--color-mist);">
    <AdminAddonsManager client:load />
  </div>
</AdminLayout>
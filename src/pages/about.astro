---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://jyotish.example.com';
---

<BaseLayout
  title="About – Jyotish Consultations | Expert Vedic Astrologer"
  description="Meet our expert Vedic astrology practitioner with 15+ years of experience in Astrology, Numerology, and Vastu Shastra. Personalized guidance for life's important decisions."
  ogImage="/about-og.jpg"
>
  <article class="section">
    <div class="container" style="max-width: 800px;">
      
      <!-- Header -->
      <header style="text-align: center; margin-bottom: 48px;">
        <p class="section-eyebrow mb-2">Our Story</p>
        <h1 class="section-title mb-3">About Jyotish Consultations</h1>
        <hr class="gold-divider" />
      </header>

      <!-- Practitioner Bio -->
      <section style="margin-bottom: 48px;">
        <h2 style="font-size: 24px; margin-bottom: 16px; color: var(--color-midnight-ink);">Meet Our Practitioner</h2>
        <p class="serif-body" style="font-size: 18px; line-height: 1.8; color: var(--color-charcoal-light); margin-bottom: 24px;">
          With over 15 years of dedicated study and practice in the Vedic sciences, our lead consultant brings ancient wisdom to modern life challenges. Trained under renowned gurus in India, they hold certifications in Jyotish Shastra (Vedic Astrology), Ank Jyotish (Numerology), and Vastu Shastra.
        </p>
        <p style="line-height: 1.7; color: var(--color-charcoal-light); margin-bottom: 16px;">
          Their approach combines traditional Vedic principles with practical, actionable guidance tailored to your unique life circumstances. Whether you're seeking clarity on career, relationships, health, or spiritual growth, each consultation is personalized to address your specific questions and concerns.
        </p>
      </section>

      <!-- Credentials -->
      <section style="margin-bottom: 48px; background: var(--color-porcelain-white); padding: 32px; border-radius: 12px;">
        <h2 style="font-size: 24px; margin-bottom: 24px; color: var(--color-midnight-ink);">Credentials & Training</h2>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <li style="margin-bottom: 16px; display: flex; align-items: flex-start; gap: 12px;">
            <span style="color: var(--color-voltage-violet); font-weight: bold;">✦</span>
            <span><strong>Certified Vedic Astrologer</strong> – Bharatiya Vidya Bhavan, Mumbai</span>
          </li>
          <li style="margin-bottom: 16px; display: flex; align-items: flex-start; gap: 12px;">
            <span style="color: var(--color-voltage-violet); font-weight: bold;">✦</span>
            <span><strong>Diploma in Numerology</strong> – Indian School of Numerology</span>
          </li>
          <li style="margin-bottom: 16px; display: flex; align-items: flex-start; gap: 12px;">
            <span style="color: var(--color-voltage-violet); font-weight: bold;">✦</span>
            <span><strong>Vastu Consultant Certification</strong> – Vastu Vishwa Academy</span>
          </li>
          <li style="margin-bottom: 16px; display: flex; align-items: flex-start; gap: 12px;">
            <span style="color: var(--color-voltage-violet); font-weight: bold;">✦</span>
            <span><strong>15+ Years</strong> of professional consultation experience</span>
          </li>
          <li style="margin-bottom: 16px; display: flex; align-items: flex-start; gap: 12px;">
            <span style="color: var(--color-voltage-violet); font-weight: bold;">✦</span>
            <span><strong>5000+ Sessions</strong> conducted across India and internationally</span>
          </li>
        </ul>
      </section>

      <!-- Philosophy -->
      <section style="margin-bottom: 48px;">
        <h2 style="font-size: 24px; margin-bottom: 16px; color: var(--color-midnight-ink);">Our Philosophy</h2>
        <p style="line-height: 1.7; color: var(--color-charcoal-light); margin-bottom: 16px;">
          We believe that Vedic sciences are not about prediction alone, but about empowerment. The charts and numbers reveal patterns and potentials, but you have the free will to shape your destiny. Our role is to illuminate the path, highlight opportunities, and provide remedies that help you navigate life's challenges with confidence.
        </p>
        <p style="line-height: 1.7; color: var(--color-charcoal-light);">
          Every consultation is confidential, respectful, and focused on providing practical solutions that you can implement immediately. We honor the sacred tradition of Jyotish while making it accessible and relevant for contemporary life.
        </p>
      </section>

      <!-- Services Summary -->
      <section style="margin-bottom: 48px;">
        <h2 style="font-size: 24px; margin-bottom: 24px; color: var(--color-midnight-ink);">Services Offered</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
          <div style="background: white; padding: 24px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <h3 style="font-size: 18px; margin-bottom: 12px; color: var(--color-voltage-violet);">Vedic Astrology</h3>
            <p style="font-size: 14px; line-height: 1.6; color: var(--color-charcoal-light);">Birth chart analysis, dasha predictions, relationship compatibility, career guidance, and remedial measures.</p>
          </div>
          <div style="background: white; padding: 24px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <h3 style="font-size: 18px; margin-bottom: 12px; color: var(--color-voltage-violet);">Numerology</h3>
            <p style="font-size: 14px; line-height: 1.6; color: var(--color-charcoal-light);">Name analysis, lucky numbers, date selection, and life path guidance based on Vedic numerology.</p>
          </div>
          <div style="background: white; padding: 24px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <h3 style="font-size: 18px; margin-bottom: 12px; color: var(--color-voltage-violet);">Vastu Shastra</h3>
            <p style="font-size: 14px; line-height: 1.6; color: var(--color-charcoal-light);">Home and office Vastu consultations, energy balancing, and practical remedies for harmony and prosperity.</p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section style="text-align: center; background: linear-gradient(135deg, var(--color-midnight-ink) 0%, var(--color-voltage-violet) 100%); padding: 48px 32px; border-radius: 12px;">
        <h2 style="font-size: 28px; color: white; margin-bottom: 16px;">Ready to Begin Your Journey?</h2>
        <p style="font-size: 16px; color: rgba(255,255,255,0.85); margin-bottom: 24px; max-width: 500px; margin-left: auto; margin-right: auto;">
          Book a personalized consultation and discover the wisdom that has guided seekers for thousands of years.
        </p>
        <a href="/#book" class="btn btn-primary" style="background: white; color: var(--color-voltage-violet); font-weight: 600;">Book Your Session</a>
      </section>

    </div>
  </article>

  <!-- Structured Data: Person -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jyotish Consultant",
    "jobTitle": "Vedic Astrologer & Numerologist",
    "description": "Expert Vedic astrology practitioner with 15+ years of experience in Astrology, Numerology, and Vastu Shastra.",
    "hasOccupation": {
      "@type": "Occupation",
      "name": "Astrologer",
      "occupationLocation": {
        "@type": "Country",
        "name": "India"
      },
      "estimatedSalary": {
        "@type": "MonetaryAmountDistribution",
        "currency": "INR",
        "name": "Consultation Fees"
      },
      "skills": ["Vedic Astrology", "Numerology", "Vastu Shastra"]
    },
    "alumniOf": [
      {
        "@type": "EducationalOrganization",
        "name": "Bharatiya Vidya Bhavan"
      },
      {
        "@type": "EducationalOrganization",
        "name": "Indian School of Numerology"
      }
    ]
  })} />
</BaseLayout>
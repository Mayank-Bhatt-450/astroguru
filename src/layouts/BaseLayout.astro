---
// src/layouts/BaseLayout.astro
// AstroGuru — public pages layout
// Includes: mobile nav, scroll-reveal observer, AstroGuru brand
import AppBootstrap from '../components/islands/AppBootstrap';
import NavBookButton from '../components/islands/NavBookButton';
import WhatsAppFab from '../components/islands/WhatsAppFab';
import BookingModal from '../components/booking/BookingModal';
import ServicePickerModal from '../components/booking/ServicePickerModal';
import DevModeBadge from '../components/islands/DevModeBadge';

interface Props {
  title?: string;
  description?: string;
}
const {
  title       = 'AstroGuru — Vedic Astrology Consultations',
  description = 'Book a private 1-on-1 consultation for astrology, numerology, or Vastu Shastra.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type"        content="website" />
</head>
<body>

  <!-- Bootstrap invisible island -->
  <AppBootstrap client:load />

  <!-- ── Navigation ── -->
  <nav class="site-nav" role="navigation" aria-label="Main navigation">
    <div class="nav-inner">
      <!-- Logo -->
      <a href="/" class="nav-logo" aria-label="AstroGuru home">
        <span class="nav-logo-star">✦</span>
        AstroGuru
      </a>

      <!-- Desktop links -->
      <ul class="nav-links" role="list">
        <li><a href="/#services">Services</a></li>
        <li><a href="/#pricing">Pricing</a></li>
        <li><a href="/#testimonials">Reviews</a></li>
        <li><a href="/#faqs">FAQs</a></li>
        <li><a href="/quick-consult">Quick Consult</a></li>
      </ul>

      <!-- Desktop CTA -->
      <div class="hide-mobile">
        <NavBookButton client:load />
      </div>

      <!-- Mobile hamburger -->
      <button
        class="nav-hamburger"
        id="nav-hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile menu -->
    <div class="mobile-menu" id="mobile-menu" role="menu">
      <a href="/#services" role="menuitem">Services</a>
      <a href="/#pricing"  role="menuitem">Pricing</a>
      <a href="/#testimonials" role="menuitem">Reviews</a>
      <a href="/#faqs"    role="menuitem">FAQs</a>
      <a href="/quick-consult" role="menuitem">Quick Consult</a>
      <NavBookButton client:load />
    </div>
  </nav>

  <!-- ── Page content ── -->
  <main>
    <slot />
  </main>

  <!-- ── Footer ── -->
  <footer class="site-footer" role="contentinfo">
    <div class="footer-grid">
      <div>
        <div class="nav-logo" style="color:white; margin-bottom:12px;">
          <span class="nav-logo-star">✦</span> AstroGuru
        </div>
        <p style="font-size:14px; line-height:1.7; max-width:280px;">
          Ancient Vedic wisdom, personalised for your modern life. Private, confidential, and deeply transformative.
        </p>
      </div>
      <div>
        <p style="font-size:11px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.4); margin-bottom:14px;">Services</p>
        <ul style="list-style:none; display:flex; flex-direction:column; gap:8px;">
          <li><a href="/#services" style="font-size:14px; color:rgba(255,255,255,0.65); transition:color 0.15s;" onmouseenter="this.style.color='white'" onmouseleave="this.style.color='rgba(255,255,255,0.65)'">Vedic Astrology</a></li>
          <li><a href="/#services" style="font-size:14px; color:rgba(255,255,255,0.65);">Numerology</a></li>
          <li><a href="/#services" style="font-size:14px; color:rgba(255,255,255,0.65);">Vastu Shastra</a></li>
          <li><a href="/quick-consult" style="font-size:14px; color:rgba(255,255,255,0.65);">Quick Consult</a></li>
        </ul>
      </div>
      <div>
        <p style="font-size:11px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.4); margin-bottom:14px;">Info</p>
        <ul style="list-style:none; display:flex; flex-direction:column; gap:8px;">
          <li><a href="/#faqs" style="font-size:14px; color:rgba(255,255,255,0.65);">FAQs</a></li>
          <li><a href="/#testimonials" style="font-size:14px; color:rgba(255,255,255,0.65);">Reviews</a></li>
          <li><a href="/#book" style="font-size:14px; color:rgba(255,255,255,0.65);">Book a Session</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} AstroGuru. All rights reserved.</span>
      <span>Made with ✦ for seekers of wisdom</span>
    </div>
  </footer>

  <!-- ── Floating islands ── -->
  <WhatsAppFab    client:load />
  <BookingModal   client:load />
  <ServicePickerModal client:load />
  <DevModeBadge   client:load />

  <!-- ── Mobile nav JS ── -->
  <script>
    const hamburger  = document.getElementById('nav-hamburger');
    const mobileMenu = document.getElementById('mobile-menu');

    hamburger?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', String(isOpen));
    });

    // Close on link click
    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
        hamburger?.setAttribute('aria-expanded', 'false');
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!hamburger?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
        mobileMenu?.classList.remove('open');
        hamburger?.setAttribute('aria-expanded', 'false');
      }
    });
  </script>

  <!-- ── Scroll-reveal observer ── -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );

    // Observe all .animate-on-scroll elements
    const observe = () => {
      document.querySelectorAll('.animate-on-scroll').forEach(el => {
        observer.observe(el);
      });
    };

    // Run now and after a short delay to catch hydrated islands
    observe();
    setTimeout(observe, 600);
    setTimeout(observe, 1400);
  </script>

  <!-- ── Hide mobile utility class ── -->
  <style>
    @media (max-width: 768px) { .hide-mobile { display: none !important; } }
  </style>

</body>
</html>